# Server-only connection injected by the Neon integration in Vercel.
DATABASE_URL=

# Generate with: pnpm organizer:password
ORGANIZER_PASSWORD_HASH=

# Generate once: openssl rand -hex 32
SESSION_SECRET=

# Optional canonical public origin, including https://, if using a custom domain.
# Otherwise sharing metadata uses Vercel's production URL automatically.
NEXT_PUBLIC_SITE_URL=
